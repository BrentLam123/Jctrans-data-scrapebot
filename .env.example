# Sao chép file này thành `.env` (hoặc export trực tiếp) trước khi chạy `python scraper.py`.
# Tài khoản đăng nhập jctrans.com (dùng tài khoản trả phí để truy cập đầy đủ thông tin contact).
JCT_EMAIL=brent@pio-logistics.vn
JCT_PASSWORD=0925587314aA

# Đường dẫn Excel xuất ra (mặc định: jctrans_data.xlsx trong thư mục hiện tại).
JCT_EXCEL=jctrans_data.xlsx

# Đường dẫn checkpoint (mặc định: jctrans_checkpoint.json).
JCT_CHECKPOINT=jctrans_checkpoint.json

# Tuỳ chọn: đường dẫn binary Chrome/Chromium nếu khác mặc định.
# CHROME_BIN=/usr/bin/google-chrome
